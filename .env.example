# ───────────────────────────────────────────────────────────────────────────
# Environment contract — copy to .env.development / .env.production and fill in.
# Real env files are git-ignored; only this example is committed.
# ───────────────────────────────────────────────────────────────────────────

# Host of the real backend API. SERVER-ONLY — used by the BFF proxy/auth routes
# (app/api/*); never exposed to the client. Do NOT prefix with NEXT_PUBLIC_.
# The version/service path (e.g. api/v1/console/...) lives in each service.ts, not here.
BACKEND_API_URL=http://localhost:7074

# Secret used to seal (AES-256-GCM) the httpOnly session cookie. SERVER-ONLY.
# Use a long random value in production, e.g.: openssl rand -base64 32
# Changing it invalidates all existing sessions (users must log in again).
SESSION_SECRET=change-me-to-a-long-random-string

# Public SDK configuration (required by the browser-side MbaasProvider)
NEXT_PUBLIC_MBAAS_BASE_URL=http://localhost:7074
NEXT_PUBLIC_MBAAS_API_KEY=change-me-to-your-mbaas-api-key
# Optional: required only when PushSdk is used
NEXT_PUBLIC_MBAAS_WEBSOCKET_URL=ws://130.185.72.14

# Server-only SDK upstream host. The proxy appends the SDK service ports (7078/8060/8075).
MBAAS_BACKEND_URL=http://130.185.72.14
